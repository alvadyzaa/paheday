# --- WAJIB ---
TELEGRAM_BOT_TOKEN=isi_token_dari_BotFather
TELEGRAM_CHAT_IDS=isi_chat_id_kamu

# --- OPSIONAL ---
# jeda cek tiap berapa detik (default 600 = 10 menit)
CHECK_INTERVAL_SECONDS=600
# jumlah post diambil per sumber per cek (default 15, maks 100)
PER_PAGE=15
# file state
STATE_FILE=state.json
# kirim juga kalau post lama di-update (episode baru)? true/false
# SANGAT disarankan true untuk dramaday.me
NOTIFY_UPDATES=true
# kirim pesan startup saat bot mulai? true/false
SEND_STARTUP_MESSAGE=false

# filter kata (case-insensitive, pisah koma). Kosong = tanpa filter.
PAHE_INCLUDE=
PAHE_EXCLUDE=
DRAMADAY_INCLUDE=
DRAMADAY_EXCLUDE=OST

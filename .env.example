# --- WAJIB ---
TELEGRAM_BOT_TOKEN=isi_token_dari_BotFather
TELEGRAM_CHAT_IDS=isi_chat_id_kamu

# --- OPSIONAL ---
# jeda cek tiap berapa detik (default 600 = 10 menit)
CHECK_INTERVAL_SECONDS=600
# jumlah post diambil per sumber per cek (default 15, maks 100)
PER_PAGE=15
# file state
STATE_FILE=state.json
# kirim juga kalau post lama di-update (episode baru)? true/false
# SANGAT disarankan true untuk dramaday.me
NOTIFY_UPDATES=true
# kirim pesan startup saat bot mulai? true/false
SEND_STARTUP_MESSAGE=false

# --- ANTI-SPAM postingan lama (mis. 2018 ke-touch lalu ikut ke-notify) ---
# Hanya postingan dengan umur publish <= batas yang boleh memicu notif.
# Patokan = tanggal publish (date), BUKAN modified. 0 = tanpa batas.
# Pahe = film sekali-post, default 14 hari. Dramaday = drama ongoing,
# default 90 hari agar update episode 2-3 bulan setelah publish tetap masuk.
PAHE_MAX_AGE_DAYS=14
DRAMADAY_MAX_AGE_DAYS=90
# Update pahe hampir selalu noise (sentuhan WP/iklan/SEO) -> default false.
# Update dramaday = episode baru -> default ikut NOTIFY_UPDATES (true).
# Set true hanya kalau kamu yakin mau notif update pahe.
PAHE_NOTIFY_UPDATES=false
DRAMADAY_NOTIFY_UPDATES=true

# filter kata (case-insensitive, pisah koma). Kosong = tanpa filter.
PAHE_INCLUDE=
PAHE_EXCLUDE=
DRAMADAY_INCLUDE=
DRAMADAY_EXCLUDE=OST
N3X_INCLUDE=
N3X_EXCLUDE=

# --- n3x.me (API JSON, tanpa modified -> hanya BARU yang fire) ---
N3X_MAX_AGE_DAYS=14
N3X_NOTIFY_UPDATES=false
